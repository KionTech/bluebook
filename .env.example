# Copy to .env. Everything has a working local default; production needs
# DATABASE_URL, the EVE application and the admin characters.

# Postgres (the docker-compose instance) and the API listen address.
# DATABASE_URL=postgres://bluebook:bluebook@127.0.0.1:5445/bluebook
# BIND_ADDR=127.0.0.1:3000
# RUST_LOG=info

# The site's own URL: grant links, Discord links, redirects.
# APP_URL=https://bluebook.nicolaskion.dev
# APP_NAME=Bluebook

# The EVE SSO application (developers.eveonline.com). Its callback is
# registered with CCP and must match EVE_CALLBACK_URL.
# EVE_CLIENT_ID=
# EVE_CLIENT_SECRET=
# EVE_CALLBACK_URL=https://bluebook.nicolaskion.dev/eve/callback

# Comma separated character ids; whoever owns one administers the
# standings.
# EVE_ADMIN_CHARACTER_ID=

# Where standing requests and source alerts go when the admin settings
# name no webhook.
# DISCORD_STANDING_REQUEST_WEBHOOK=

# The schedule: the standings sync every 5 minutes, the affiliation
# refresh hourly at :37, the lapsed token mail daily at 00:00 UTC. It
# writes to the pilots' in-game contact lists, so it is off unless asked
# for. QUEUE_WORKERS jobs run at once.
# SCHEDULER_ENABLED=false
# QUEUE_WORKERS=5

# ESI: the user agent CCP asks for, and a cap on requests per second
# (0 for none).
# ESI_USER_AGENT=Bluebook (+https://bluebook.nicolaskion.dev)
# ESI_MAX_RPS=20

# How long a sign-in lasts.
# SESSION_LIFETIME_DAYS=400

# The one-click demo login at /demo-login, for local stacks only
# (docker-compose turns it on; seed the demo with
# `docker compose run --rm demo-seed` or `cargo run --bin seed_demo`).
# DEMO_ENABLED=false
# DEMO_CHARACTER_ID=2100000001

# External services, for tests and local mocks.
# ESI_BASE_URL=https://esi.evetech.net
# SSO_BASE_URL=https://login.eveonline.com

# Tests only.
# TEST_DATABASE_URL=postgres://bluebook:bluebook@127.0.0.1:5445/bluebook_test
