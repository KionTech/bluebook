  "sql": [
    "insert into standing_requests (subject_type, subject_id, requested_by_character_id, status, created_at, updated_at) select 'character', 96000000 + n, 95000010, 'pending', {minutes:-500}, {minutes:-500} from (select a.n + b.n * 10 as n from (select 0 n union select 1 union select 2 union select 3 union select 4 union select 5 union select 6 union select 7 union select 8 union select 9) a, (select 0 n union select 1 union select 2) b) numbers where n < 28",
    "update standing_requests set created_at = date_sub(created_at, interval subject_id - 96000000 second) where subject_id >= 96000000"
  ],
